{
  "name": "jaredgoldberg-org",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs --watch",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "npm run build && node --test tests/*.test.mjs && npm run test:ops",
    "test:browser": "node --test tests/browser.test.mjs",
    "capture:source": "node scripts/capture-source.mjs",
    "test:ops": "python3 -m unittest discover -s tests -p '*_test.py'"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "playwright": "1.63.0"
  }
}
