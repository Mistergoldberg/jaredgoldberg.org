-      { label: 'Visit Picarty, a related study of photography, participation and interface', href: 'https://picarty.com/' },
+      { label: 'Experience 640 × 480 through Pixilation', href: 'https://pixilation.org/' },
+      { label: 'Try the current Picarty/Mashup interface', href: 'https://picarty.com/' },
+      { label: "Read Goldberg's essay on the medium", href: 'https://jaredgoldberg.ca/writing/medium-is-the-message/' },
